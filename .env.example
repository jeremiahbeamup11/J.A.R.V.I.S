# --- Core ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
MAC_AGENT_URL=http://localhost:8765

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# --- Local brain (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Grok Build (Milestone 10) ---
# Comma-separated project roots Grok is allowed to work under.
# Build mode is allowed immediately on paths under these roots.
# Example: ~/Desktop,~/Projects,/Users/you/code
GROK_BUILD_ALLOWLIST=

# Optional default project when the user doesn't name a path.
# Must still resolve under the allowlist.
GROK_BUILD_DEFAULT_CWD=

# Optional: path to grok binary (default ~/.grok/bin/grok)
# GROK_BIN=/Users/you/.grok/bin/grok

# Optional tuning
# GROK_BUILD_MAX_TURNS=40
# GROK_BUILD_TIMEOUT_SEC=900
# If true: when no stored session id, use `grok -c` (continue latest in cwd)
# GROK_BUILD_CONTINUE_WITHOUT_ID=false

# --- Workshop (Milestone 11 — design / 3D work products) ---
# Where Jarvis writes STL models + design briefs (created automatically).
# WORKSHOP_DIR=~/Desktop/JARVIS/workshop
# Extra roots mac_agent may open (comma-separated). Workshop + ~/Desktop/JARVIS
# are always included.
# OPEN_PATH_ALLOWLIST=
# Optional: full path to Blender binary if not in /Applications/Blender.app
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# BLENDER_TIMEOUT_SEC=180

# --- Phone remote (iPhone Safari at /phone) ---
# Optional shared secret. If set, phone UI needs Bearer token.
# JARVIS_PHONE_TOKEN=
# Port advertised in status hints (match uvicorn --port)
# JARVIS_PORT=8010

# --- Memory (Milestone 13) ---
# Default: ~/Desktop/JARVIS/data/memory/
# MEMORY_DIR=
# MEMORY_SESSION_MAX_TURNS=24
# MEMORY_SESSION_IDLE_MINUTES=180
# MEMORY_LONG_TERM_MAX=200
